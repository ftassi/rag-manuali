# Directory persistente (documenti, pagine renderizzate e database)
MANUALI_DATA_DIR=./data

# API OpenAI-compatibile di Ollama. llama3.2:3b e' testuale: niente immagini/caption.
MANUALI_LLM_BASE_URL=http://127.0.0.1:11434/v1
MANUALI_LLM_MODEL=llama3.2:3b
MANUALI_LLM_TIMEOUT=300

# Modello embedding dedicato tramite l'API OpenAI-compatibile di Ollama.
# Usare "hash" soltanto per sviluppo rapido senza Ollama.
MANUALI_EMBEDDING_PROVIDER=openai
MANUALI_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
MANUALI_EMBEDDING_MODEL=nomic-embed-text-v2-moe
MANUALI_EMBEDDING_TIMEOUT=120
MANUALI_HASH_EMBEDDING_DIMENSIONS=384

# PDF e immagini
MANUALI_RENDER_DPI=130
MANUALI_OCR_ENABLED=false
MANUALI_OCR_LANGUAGES=ita+eng
MANUALI_OCR_MIN_CHARS=80

# off | visual | all. "visual" descrive pagine con immagini/disegni o poco testo.
MANUALI_CAPTION_MODE=off
MANUALI_MAX_IMAGES_PER_QUESTION=0

# Chunking e retrieval
MANUALI_CHUNK_CHARS=2200
MANUALI_CHUNK_OVERLAP_CHARS=250
MANUALI_RETRIEVAL_CANDIDATES=30
MANUALI_RETRIEVAL_SEMANTIC_WEIGHT=1.0
MANUALI_RETRIEVAL_LEXICAL_WEIGHT=1.0
MANUALI_RETRIEVAL_RRF_K=60
MANUALI_ANSWER_AMBIGUITY_MARGIN=0.02
MANUALI_DEFAULT_TOP_K=5
