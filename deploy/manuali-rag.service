[Unit]
Description=Manuali RAG API
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/manuali-rag
EnvironmentFile=/opt/manuali-rag/.env
ExecStart=/opt/manuali-rag/.venv/bin/manuali-rag serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
MemoryHigh=6500M
Nice=5

[Install]
WantedBy=multi-user.target
